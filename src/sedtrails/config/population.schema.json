{
    "$id": "urn:sedtrails:config:population.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema#",
    "type": "object",
    "title": "SedTrails Population Configuration",
    "description": "Configuration for particle populations in SedTrails",
    "unevaluatedProperties": false,
    "$defs": {
        "passive_characteristics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "diffusion_coefficient": {
                    "type": "number",
                    "default": 0.0,
                    "description": "random walk diffusion coefficient (horizontal diffusivity K_h) for passive particles"
                }
            }
        },
        "sand_characteristics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "density": {
                    "type": "number",
                    "default": 2650.0,
                    "description": "density of sand particles [kg/m3]"
                },
                "grain_size": {
                    "type": "number",
                    "default": 0.0005,
                    "description": "grain size of sand particles [m]"
                }
            },
            "required": [
                "density",
                "grain_size"
            ]
        },
        "mud_characteristics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "density": {
                    "type": "number",
                    "default": 2000.0,
                    "description": "density of mud particles [kg/m3]"
                },
                "size": {
                    "type": "number",
                    "default": 0.00005,
                    "description": "grain size of mud particles [m]"
                }
            },
            "required": [
                "density",
                "size"
            ]
        },
        "van_westen_method": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "flow_field_name": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    },
                    "description": "flow field name for van Westen method used in particle computation"
                },
                "beta": {
                    "type": "number",
                    "default": 0.2,
                    "description": "beta parameter for van Westen method"
                },
                "suspended_velocity_method": {
                    "type": "string",
                    "enum": ["soulsby_2011", "macdonald_2006"],
                    "default": "soulsby_2011",
                    "description": "Method for computing suspended sediment velocity. 'soulsby_2011': Rouse-profile ratio (van Westen et al. 2025). 'macdonald_2006': log-profile at suspended sediment centroid height (MacDonald 2006, Eqs. 27-29)."
                }
            },
            "required": [
                "flow_field_name"
            ],
            "description": "van Westen method for particle tracking"
        },
        "macdonald_method": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "flow_field_name": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    },
                    "description": "flow field name for MacDonald method used in particle computation"
                },
                "computationType": {
                    "type": "string",
                    "enum": ["2D", "Q3D"],
                    "default": "2D",
                    "description": "Type of implemented MacDonald computation: depth-averaged 2D or quasi-3D Q3D."
                },
				"use_transport_fields": {
				  "type": "string",
				  "enum": ["model-native", "SoulsbyvanRijn1997"],
				  "default": "model-native",
				  "description": "Select which transport fields are used for particle transport. 'model-native' uses transport velocity fields from Delft3D-FM; 'SoulsbyvanRijn1997' computes Soulsby-vanRijn transports."
				},
                "shear_velocity_source": {
                  "type": "string",
                  "enum": ["max", "mean"],
                  "default": "mean",
                  "description": "Select the current shear velocity used for suspension profiles and Q3D diffusion when transport fields are calculated. Model-native transport instead uses the current shear derived consistently from depth-averaged velocity and effective Chezy. Maximum bed shear remains fixed for Shields mobilisation, resuspension, pickup, and active-layer calculations."
                },
                "entrainment": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "method": {
                      "type": "string",
                      "enum": ["shields_threshold", "non_zero_particle_velocity", "entrainment_frequency"],
                      "default": "shields_threshold",
                      "description": "MacDonald 2D and Q3D bed-to-suspension transition rule. shields_threshold applies the critical Shields criterion; non_zero_particle_velocity makes every eligible deposited particle available and lets its calculated transport velocity determine motion; entrainment_frequency uses the configured probability law."
                    },
                    "probability_law": {
                      "type": "string",
                      "enum": ["poisson", "linear"],
                      "description": "Optional probability conversion used only with method entrainment_frequency. If omitted, poisson is used. poisson uses 1-exp(-f_e*dt); linear uses min(f_e*dt, 1)."
                    }
                  },
                  "dependentSchemas": {
                    "probability_law": {
                      "properties": {
                        "method": {"const": "entrainment_frequency"}
                      },
                      "required": ["method"]
                    }
                  },
                  "default": {
                    "method": "shields_threshold"
                  },
                  "description": "Shared entrainment configuration used by MacDonald 2D and Q3D."
                },
                "deposition": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "method": {
                      "type": "string",
                      "enum": ["shields_threshold", "markov_settling"],
                      "default": "shields_threshold",
                      "description": "MacDonald 2D deposition rule. shields_threshold deposits when local Shields mobility is at or below critical or particle velocity is zero. markov_settling uses the memoryless settling transition probability 1-exp(-nu*dt)."
                    },
                    "settling_height_field": {
                      "type": "string",
                      "enum": ["suspended_transport_centroid_elevation", "water_depth"],
                      "default": "suspended_transport_centroid_elevation",
                      "description": "Settling distance h used by markov_settling: the suspended-load centroid elevation or the full local water depth."
                    },
                    "minimum_settling_height": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "default": 0.001,
                      "description": "Positive lower bound [m] applied to the selected settling height in the Markov transition-rate calculation."
                    }
                  },
                  "default": {
                    "method": "shields_threshold",
                    "settling_height_field": "suspended_transport_centroid_elevation",
                    "minimum_settling_height": 0.001
                  },
                  "description": "Deposition configuration used by MacDonald 2D."
                },
				"max_suspended_velocity_factor": {
				  "type": ["number", "null"],
				  "default": 1.0,
				  "description": "Optional cap on suspended-load advection velocity, expressed as a multiple of the depth-averaged flow velocity. If null, no capping is applied."
				},
				"q3d_horizontal_diffusion_enabled": {
				  "type": "boolean",
				  "default": true,
				  "description": "If false, disable Q3D horizontal turbulent diffusion and its random-walk velocity components without changing geometric-scheme vertical diffusion."
				},
				"q3d_vertical_diffusion_factor": {
				  "type": "number",
				  "minimum": 0.0,
				  "default": 0.15,
				  "description": "Dimensionless Q3D vertical diffusion factor. SedTRAILS uses a depth-scaled variant of MacDonald Eq. 49 so water depth supplies the length scale required for diffusivity units of m^2/s."
				},
				"q3d_vertical_update_scheme": {
				  "type": "string",
				  "enum": ["geometric", "centroid_floor", "rouse_profile", "rouse_sample"],
				  "default": "geometric",
				  "description": "Q3D vertical position update scheme. geometric applies the bed-change correction z_p,new = z_p,old + w dt + bed_old - bed_new; centroid_floor applies settling only in absolute z and prevents suspended particles from falling below the new total-transport centroid; rouse_sample samples the new height above bed from a Rouse-shaped distribution using the MacDonald rouse_number field."
				},
				"q3d_motion_substeps": {
				  "type": "integer",
				  "minimum": 1,
				  "default": 1,
				  "description": "Number of Q3D horizontal/vertical particle motion substeps per outer particle timestep. A value of 1 gives the original single-step update."
				},
				"q3d_save_first_substep_diagnostics": {
				  "type": "boolean",
				  "default": false,
				  "description": "If true, store Q3D hydraulic and diffusion fields sampled at the first motion substep."
				},
				"export_diagnostic_fields": {
				  "type": "boolean",
				  "default": false,
				  "description": "If true, also compute and export MacDonald diagnostic-only fields that are not read by any part of the transport/entrainment/deposition pipeline: grid-level fields shared by 2D and Q3D (e.g. shear_velocity_ratio, suspended_transport_ratio, bedload_velocity, chezy diagnostics) and, for Q3D, the grid-level diffusion and vertical-velocity fields that are redundant with the particle-level Q3D calculation. Leave false to reduce memory use on larger simulations."
				}
            },
            "required": [
                "flow_field_name"
            ],
            "description": "Macdonald method for particle tracking"
        },
        "soulsby_method": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "flow_field_name": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    },
                    "description": "List of flow field names to use for Soulsby method (e.g., ['grain_velocity', 'soulsby_a', 'soulsby_b'])"
                },
                "tracer_grain_size": {
                    "type": "number",
                    "default": 0.0002,
                    "description": "Grain size of tracer sediment [m]"
                },
                "background_grain_size": {
                    "type": "number",
                    "default": 0.0002,
                    "description": "Grain size of background sediment [m]"
                },
                "soulsby_b_e": {
                    "type": "number",
                    "default": 1.7e-07,
                    "description": "Maximum free-to-trapped transition probability per second [1/s]"
                },
                "soulsby_theta_s": {
                    "type": "number",
                    "default": 0.1,
                    "description": "Transition scale value [-]"
                },
                "soulsby_gamma_e": {
                    "type": "number",
                    "default": 0.1,
                    "description": "Long-term equilibrium proportion of free particles [-]"
                },
                "soulsby_mu_d": {
                    "type": "number",
                    "default": 0.5,
                    "description": "Dynamic friction coefficient (0.5-1.0) [-]"
                },
                "soulsby_freedom_factor": {
                    "type": "number",
                    "default": 1,
                    "description": "Initial state of Freedom Factor (0 = trapped, 1 = free) [-]"
                }
            },
            "required": [
                "flow_field_name"
            ],
            "description": "Soulsby method for particle tracking"
        },
        "passive_method": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "flow_field_name": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "depth_avg_flow_velocity"
                    ],
                    "description": "List of flow field names to use for passive tracer method"
                }
            },
            "description": "Passive tracer method for particle tracking"
        }
    },
    "properties": {
        "name": {
            "type": "string",
            "default": "particle",
            "description": "name of the particle population, e.g., 'sediment', 'sand-01', 'mud-a'"
        },
        "particle_type": {
            "type": "string",
            "enum": [
                "passive",
                "sand",
                "mud"
            ],
            "default": "passive",
            "description": "type of particles for population (supported values: 'passive', 'sand', 'mud')"
        },
        "characteristics": {
            "type": "object",
            "description": "characteristics specific to the particle type"
        },
        "diffusion": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "method": {
                    "type": "string",
                    "enum": ["none", "brownian"],
                    "default": "brownian",
                    "description": "Optional horizontal diffusion method."
                },
                "coefficient": {
                    "type": "number",
                    "minimum": 0.0,
                    "default": 0.0,
                    "description": "Horizontal diffusivity kh in m^2/s."
                },
                "seed": {
                    "type": "integer",
                    "description": "Optional per-population random seed."
                }
            },
            "default": {"method": "brownian", "coefficient": 0.0}
        },
        "tracer_methods": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "vanwesten": {
                    "$ref": "#/$defs/van_westen_method"
                },
                "soulsby": {
                    "$ref": "#/$defs/soulsby_method"
                },
                "macdonald": {
                    "$ref": "#/$defs/macdonald_method"
                },
                "passive_tracer": {
                    "$ref": "#/$defs/passive_method"
                }
            },
            "minProperties": 1,
            "maxProperties": 1,
            "default": {
                "passive_tracer": {
                    "flow_field_name": [
                        "depth_avg_flow_velocity"
                    ]
                }
            },
            "description": "Exactly one tracer method must be specified"
        },
        "transport_probability": {
            "type": "string",
            "enum": [
                "no_probability",
                "stochastic_transport",
                "reduced_velocity"
            ],
            "default": "no_probability",
            "description": "Method for applying transport probability: 'no_probability' (passive/always transport), 'stochastic_transport' (probabilistic transport per timestep), 'reduced_velocity' (velocity field reduced by probability)"
        },
        "sediment_fraction_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based sediment fraction index used for this population when input transport contains multiple fractions (e.g. Delft3D4 LSED/LSEDTOT)."
        },
        "sediment_fraction_name": {
            "type": "string",
            "description": "Sediment fraction label used for this population when labels are available (takes precedence over sediment_fraction_index)."
        },
        "seeding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "burial_depth": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "burial depth configuration for particles. If not used, then burial depth computations are not considered.",
                    "properties": {
                        "random": {
                            "type": "number",
                            "description": "maximum depth from bed level (surface) for random burial depth in meters."
                        },
                        "constant": {
                            "type": "number",
                            "description": "constant burial depth in meters."
                    }
                    },
                    "oneOf": [
                        {
                            "type": "number",
                            "minimum": 0
                        },
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "random": {
                                    "type": "number",
                                    "minimum": 0,
                                    "default": 1.0,
                                    "description": "maximum depth from bed level (surface) for random burial depth in meters."
                                },
                                "constant": {
                                    "type": "number",
                                    "minimum": 0,
                                    "default": 1.0,
                                    "description": "constant burial depth in meters."
                                }
                            },
                            "oneOf": [
                                {
                                    "required": [
                                        "random"
                                    ]
                                },
                                {
                                    "required": [
                                        "constant"
                                    ]
                                }
                            ]
                        }
                    ]
                },
                "vertical_position": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Optional initial vertical position of particles. Resolved after bed level and water depth are known.",
                    "default": {
                        "mode": "burial_depth"
                    },
                    "properties": {
                        "mode": {
                            "type": "string",
                            "enum": [
                                "burial_depth",
                                "bed",
                                "height_above_bed",
                                "absolute_z",
                                "centroid_on_release"
                            ],
                            "default": "burial_depth",
                            "description": "Vertical initialization mode: use configured burial_depth, bed level, a height above bed, an absolute model z, or the Q3D centroid/entrainment height at release."
                        },
                        "value": {
                            "type": "number",
                            "description": "Vertical value for height_above_bed [m] or absolute_z [m in model vertical datum]."
                        }
                    },
                    "required": [
                        "mode"
                    ],
                    "allOf": [
                        {
                            "if": {
                                "properties": {
                                    "mode": {
                                        "enum": ["height_above_bed", "absolute_z"]
                                    }
                                }
                            },
                            "then": {
                                "required": ["value"]
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "mode": {
                                        "enum": ["burial_depth", "bed", "centroid_on_release"]
                                    }
                                }
                            },
                            "then": {
                                "not": {
                                    "required": ["value"]
                                }
                            }
                        }
                    ]
                },
                "class": {
                    "type": "string",
                    "default": "clusters",
                    "description": "specify class of source to be used (choose from 'clusters','pointSource','lineSource','regularGrid','densePatch')"
                },
                "quantity": {
                    "type": "number",
                    "default": 1,
                    "description": "number of particles to release per release location. Release locations are determined by the release strategy."
                },
                "per_timestep": {
                    "type": "boolean",
                    "default": false,
                    "description": "release particles per timestep? true/false"
                },
                "release_type": {
                    "type": "string",
                    "default": "instantaneous",
                    "description": "type of release: 'instantaneous' or 'continuous'"
                },
                "lifespan": {
                    "type": "number",
                    "default": 9e+99,
                    "description": "life span of particles in seconds"
                },
                "release_start": {
                    "type": "string",
                    "description": "release start time, e.g., '2020-01-01 00:00:00'. If empty, then release starts at the beginning of the simulation."
                },
                "release_stop": {
                    "type": "string",
                    "description": "release stop time, e.g., '2020-01-01 01:00:00'. If empty, then release stops immediately after the first particles are released."
                },
                "remove_permanently_buried": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, particles whose initial burial depth exceeds the maximum possible exposure depth (max_erosion + max_mixing_depth) at their location are removed before the simulation starts (computed automatically by the simulation when enabled)."
                },
                "strategy": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "point": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "pol_file": {
                                    "type": "string",
                                    "description": "path to Deltares '.pol; file with list of points to release particles from"
                                },
                                "locations": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "a list of X,Y coordinates reprsenting points where particles will be released, e.g., 1000,2000 "
                                },
                                "show_check_plots": {
                                    "type": "boolean",
                                    "default": false,
                                    "description": "Do you want to show cluster check plots? TODO: move to validation section"
                                },
                                "save_check_plots": {
                                    "type": "boolean",
                                    "default": false,
                                    "description": "Do you want to save cluster check plots? TODO: move to validation section"
                                }
                            },
                            "oneOf": [
                                {
                                    "required": [
                                        "pol_file"
                                    ]
                                },
                                {
                                    "required": [
                                        "locations"
                                    ]
                                }
                            ]
                        },
                        "transect": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "pol_file": {
                                    "type": "string",
                                    "description": "path to Deltares '.pol; file with list of transects (line segments) to release particles from"
                                },
                                "segments": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "a list of line segments along which particles are released, e.g., '1000,2000 3000,4000'"
                                },
                                "k": {
                                    "type": "number",
                                    "default": 100.0,
                                    "description": "number of release points to create per segment"
                                },
                                "show_check_plots": {
                                    "type": "boolean",
                                    "default": false,
                                    "description": "Do you want to show cluster check plots?"
                                },
                                "save_check_plots": {
                                    "type": "boolean",
                                    "default": false,
                                    "description": "Do you want to save cluster check plots?"
                                }
                            },
                            "oneOf": [
                                {
                                    "required": [
                                        "pol_file"
                                    ]
                                },
                                {
                                    "required": [
                                        "segments"
                                    ]
                                }
                            ]
                        },
                        "random": {
                            "type": "object",
                            "description": "Random area release. Define the release area with `bbox` or `poly`; legacy `pol_file` is not supported here. Use `poly: path/to/file.pol` for polygon files. If both `bbox` and `poly` are provided, the polygon is used.",
                            "additionalProperties": false,
                            "properties": {
                                "bbox": {
                                    "type": "string",
                                    "description": "bounding box for random point generation, as 'xmin,ymin xmax,ymax'"
                                },
                                "poly": {
                                    "description": "polygon boundary for random point generation; either a path to a polygon file (.pol, CSV, or plain text) or an inline list of 'x,y' coordinate strings (minimum 3 vertices)",
                                    "oneOf": [
                                        {
                                            "type": "string",
                                            "minLength": 1,
                                            "description": "path to polygon file (.pol, CSV, or plain text)"
                                        },
                                        {
                                            "type": "array",
                                            "items": { "type": "string" },
                                            "minItems": 3,
                                            "description": "inline polygon as a list of 'x,y' or 'x y' coordinate strings"
                                        }
                                    ]
                                },
                                "nlocations": {
                                    "type": "integer",
                                    "default": 1,
                                    "description": "number of random points to generate within the bounding box or polygon"
                                },
                                "seed": {
                                    "type": "number",
                                    "default": 42,
                                    "description": "seed for random number generator"
                                },
                                "show_check_plots": {
                                    "type": "boolean",
                                    "default": false,
                                    "description": "Do you want to show cluster check plots?"
                                },
                                "save_check_plots": {
                                    "type": "boolean",
                                    "default": false,
                                    "description": "Do you want to save cluster check plots?"
                                }
                            },
                            "required": [
                                "nlocations"
                            ],
                            "anyOf": [
                                { "required": ["bbox"] },
                                { "required": ["poly"] }
                            ]
                        },
                        "grid": {
                            "type": "object",
                            "description": "Regular grid area release. Define the release area with `bbox` or `poly`; legacy `pol_file` is not supported here. Use `poly: path/to/file.pol` for polygon files. If both `bbox` and `poly` are provided, the polygon is used.",
                            "additionalProperties": false,
                            "properties": {
                                "bbox": {
                                    "type": "string",
                                    "description": "bounding box for grid generation, as 'xmin,ymin xmax,ymax'"
                                },
                                "poly": {
                                    "description": "polygon boundary for grid generation; either a path to a polygon file (.pol, CSV, or plain text) or an inline list of 'x,y' coordinate strings (minimum 3 vertices)",
                                    "oneOf": [
                                        {
                                            "type": "string",
                                            "minLength": 1,
                                            "description": "path to polygon file (.pol, CSV, or plain text)"
                                        },
                                        {
                                            "type": "array",
                                            "items": { "type": "string" },
                                            "minItems": 3,
                                            "description": "inline polygon as a list of 'x,y' or 'x y' coordinate strings"
                                        }
                                    ]
                                },
                                "separation": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "dx": {
                                            "type": "number",
                                            "default": 100.0,
                                            "description": "grid spacing in x-direction [m]"
                                        },
                                        "dy": {
                                            "type": "number",
                                            "default": 100.0,
                                            "description": "grid spacing in y-direction [m]"
                                        }
                                    },
                                    "required": [
                                        "dx",
                                        "dy"
                                    ]
                                },
                                "show_check_plots": {
                                    "type": "boolean",
                                    "default": false,
                                    "description": "Do you want to show cluster check plots?"
                                },
                                "save_check_plots": {
                                    "type": "boolean",
                                    "default": false,
                                    "description": "Do you want to save cluster check plots?"
                                }
                            },
                            "required": [
                                "separation"
                            ],
                            "anyOf": [
                                { "required": ["bbox"] },
                                { "required": ["poly"] }
                            ]
                        },
                        "file_points": {
                            "type": "object",
							       "additionalProperties": false,
                            "properties": {
                                 "path":       { "type": "string", "minLength": 1, "description": "Path to text/CSV/TSV with x,y columns" },
                                 "x_col":      { "oneOf": [ { "type": "integer", "minimum": 0 }, { "type": "string", "minLength": 1 } ], "description": "Column index or name for x" },
                                 "y_col":      { "oneOf": [ { "type": "integer", "minimum": 0 }, { "type": "string", "minLength": 1 } ], "description": "Column index or name for y" },
                                 "has_header": { "type": "boolean", "default": true },
                                 "deduplicate":{ "type": "boolean", "default": true },
                                 "dropna":     { "type": "boolean", "default": true },
                                 "stride":     { "type": "integer", "minimum": 1, "default": 1, "description": "Keep every Nth point" },
                                 "bbox": {
                                 "oneOf": [
                                    { "type": "string", "description": "xmin,ymin xmax,ymax (commas/whitespace allowed)" },
                                    {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                       "xmin": { "type": "number" },
                                       "ymin": { "type": "number" },
                                       "xmax": { "type": "number" },
                                       "ymax": { "type": "number" }
                                    },
                                    "required": ["xmin","ymin","xmax","ymax"]
                                    }
                                 ]
                                 }
                              },
                              "required": ["path"]
                           }
                    },
                    "oneOf": [
                        {
                            "required": [
                                "point"
                            ]
                        },
                        {
                            "required": [
                                "transect"
                            ]
                        },
                        {
                            "required": [
                                "random"
                            ]
                        },
                        {
                            "required": [
                                "grid"
                            ]
                        },
                        {
                            "required": [
                                "file_points"
                            ]
                        }
                    ]
                }
            },
            "required": [
                "quantity"
            ]
        },
        "barriers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "po_file": {
                    "type": "string",
                    "description": "path to Deltares '.pol' file containing thin dams/permeable strucures"
                }
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "particle_type": {
                        "const": "passive"
                    }
                }
            },
            "then": {
                "properties": {
                    "characteristics": {
                        "$ref": "#/$defs/passive_characteristics"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "particle_type": {
                        "const": "sand"
                    }
                }
            },
            "then": {
                "properties": {
                    "characteristics": {
                        "$ref": "#/$defs/sand_characteristics"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "particle_type": {
                        "const": "mud"
                    }
                }
            },
            "then": {
                "properties": {
                    "characteristics": {
                        "$ref": "#/$defs/mud_characteristics"
                    }
                }
            }
        }
    ],
    "required": [
        "name",
        "particle_type",
        "characteristics",
        "tracer_methods",
        "seeding"
    ]
}
